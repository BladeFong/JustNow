<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限（节假日数据获取） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 精确闹钟权限（Android 12+） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 相机权限（调用系统相机拍照） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机广播权限（手机重启后自动恢复闹钟） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 包可见性（Android 11+）：用于 APP 跳转编辑器搜索已安装应用，
         默认只能看到本应用、不声明则 getInstalledApplications 返回极少数预装应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".JustNowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustNow">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.JustNow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.taskinput.TaskInputActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.tagmanage.TagManageActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.taskschedule.TaskScheduleActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false" />

        <activity
            android:name=".ui.period.PeriodConfigActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.stats.StatsActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false" />

        <activity
            android:name=".ui.displaypolicy.DisplayPolicyActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ui.reminderdetail.ReminderDetailActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetPermissionGateActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="true" />

        <!-- 跨应用 Intent 捕获入口 -->
        <activity
            android:name=".ui.appactioncapture.AppActionCaptureActivity"
            android:exported="true"
            android:label="@string/s_capture_activity_label"
            android:theme="@style/Theme.JustNow"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <!-- A. 浏览器跳 APP 选择器（非 http(s) 自定义 scheme，运行时白名单过滤） -->
            <intent-filter android:label="@string/s_capture_filter_scheme">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="*" />
            </intent-filter>
            <!-- B. 系统文本分享接收 -->
            <intent-filter android:label="@string/s_capture_filter_send">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 捕获后任务选择/新建 -->
        <activity
            android:name=".ui.appactioncapture.CapturePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.JustNow"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 成果时光胶囊回顾照片墙页面 -->
        <activity
            android:name=".ui.main.TimeCapsuleWallActivity"
            android:theme="@style/Theme.JustNow"
            android:exported="false" />

        <!-- 桌面 Widget -->
        <receiver
            android:name=".widget.JustNowWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_provider" />
        </receiver>

        <!-- 提醒闹钟接收器（支持开机自动恢复全部闹钟调度） -->
        <receiver
            android:name=".broadcast.AlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 整分钟边界闹钟接收器（由 AlarmManager 显式 Intent 触发，无需 intent-filter） -->
        <receiver
            android:name=".widget.MinuteBoundaryReceiver"
            android:exported="false" />

        <!-- FileProvider：用于安全共享拍照后的临时物理文件Uri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
