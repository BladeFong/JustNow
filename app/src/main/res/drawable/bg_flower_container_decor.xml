<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第一层：收集栏大背景 (带 12dp 柔和圆角) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF9FC" />
            <stroke
                android:width="2dp"
                android:color="#FF80AB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- 第二层：卡通内缩圆角虚线框 (缩进 4dp，亮粉色虚线) -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#FF4081"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
