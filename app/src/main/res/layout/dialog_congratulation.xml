<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/badge_bg"
    android:clipToOutline="true"> <!-- 必须切割，以保留头部顶端圆角 -->

    <!-- 1. 顶部 Header 栏 (高度 48dp，背景色及右侧文案由 Java 动态染色修改) -->
    <RelativeLayout
        android:id="@+id/rl_congrat_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:background="#F44336"> <!-- 默认 Q1 红色 -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🏆 任务完成祝贺"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_congrat_quadrant_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Q1 象限"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_congrat_tag_capsule" />
    </RelativeLayout>

    <!-- 2. 中部及底部主体容器 (带 24dp padding) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 卡通大红花勋章插图 -->
        <ImageView
            android:id="@+id/iv_congrat_badge"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_congrats_badge"
            android:contentDescription="完成勋章" />

        <!-- 赞美大标题 (颜色与象限一致) -->
        <TextView
            android:id="@+id/tv_congrat_congrats_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="“您好棒！”"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#F44336"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.05" />

        <!-- 副标题引导文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="快去让爸爸妈妈帮忙，\n拍照记录成果吧！"
            android:textSize="17sp"
            android:textColor="#333333"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- 3. 底部并排操作按钮 (右侧去拍照按钮背景色与象限一致) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_congrat_skip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="暂不拍照"
                android:textColor="@color/text_secondary"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_congrat_action"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="12dp"
                android:text="📸 去拍照记录"
                android:textColor="@android:color/white"
                app:backgroundTint="#F44336"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
