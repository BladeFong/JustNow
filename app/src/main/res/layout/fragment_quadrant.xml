<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- 任务草稿摘要（突出显示） -->
    <TextView
        android:id="@+id/tv_draft_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.JustNow.Title"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- 降级恢复周期 -->
    <LinearLayout
        android:id="@+id/ll_degrade_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:contentDescription="降级恢复周期">

        <TextView
            android:id="@+id/chip_degrade_next_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:background="@drawable/bg_day_chip"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            android:textColor="@color/chip_day_text"
            android:text="@string/s_degrade_next_day"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chip_degrade_next_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:background="@drawable/bg_day_chip"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            android:textColor="@color/chip_day_text"
            android:text="@string/s_degrade_next_week"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chip_degrade_next_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:background="@drawable/bg_day_chip"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            android:textColor="@color/chip_day_text"
            android:text="@string/s_degrade_next_month"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chip_degrade_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:background="@drawable/bg_day_chip"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            android:textColor="@color/chip_day_text"
            android:text="@string/s_degrade_none"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 2x2 象限网格 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="2">

        <!-- 紧急重要 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_quadrant_urgent_important"
            android:id="@+id/cv_urgent_important">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@color/quadrant_bg_0">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_urgent" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_urgent_important" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_important" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_urgent_important" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 紧急不重要 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_quadrant_urgent_not_important"
            android:id="@+id/cv_urgent_not_important">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@color/quadrant_bg_1">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_urgent" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_urgent_not_important" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_not_important" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_urgent_not_important" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 不紧急重要 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_quadrant_not_urgent_important"
            android:id="@+id/cv_not_urgent_important">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@color/quadrant_bg_2">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_not_urgent" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_not_urgent_important" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_important" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_not_urgent_important" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 不紧急不重要 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_quadrant_not_urgent_not_important"
            android:id="@+id/cv_not_urgent_not_important">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@color/quadrant_bg_3">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_not_urgent" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_not_urgent_not_important" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_not_important" android:textAppearance="@style/TextAppearance.JustNow.Body" android:textColor="@color/quadrant_not_urgent_not_important" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </GridLayout>


</LinearLayout>
