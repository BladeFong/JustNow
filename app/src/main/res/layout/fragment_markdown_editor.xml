<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Markdown 格式工具条 -->
    <HorizontalScrollView
        android:id="@+id/hsv_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?android:attr/colorBackground"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_h1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_h1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_h2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_h2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bold"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_bold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_italic"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_italic"
                android:textSize="13sp"
                android:textStyle="italic"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bullet_list"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_bullet_list"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_numbered_list"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_numbered_list"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_task_list"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_task_list"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quote"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_quote"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_code"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_code"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_divider"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center"
                android:text="@string/s_md_divider"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 编辑与预览主区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 编辑框：独立全屏垂直滚动 -->
        <EditText
            android:id="@+id/et_markdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:hint="@string/s_markdown_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:background="@null"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            android:lineSpacingExtra="4dp" />

        <!-- 预览视图：垂直滚动 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textAppearance="@style/TextAppearance.JustNow.Body"
                android:lineSpacingExtra="4dp" />
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 底部操作底栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_mode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:text="@string/s_markdown_preview"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/s_done_editing"
            android:textAppearance="@style/TextAppearance.JustNow.Body"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
