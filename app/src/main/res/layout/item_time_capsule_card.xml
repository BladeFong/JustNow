<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <!-- 顶层采用水平排布，最左侧放置象征四象限的竖条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 四象限主题色竖色条 (根据象限类型动态染色) -->
        <View
            android:id="@+id/v_quadrant_bar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/quadrant_urgent_important" /> <!-- 默认一象限颜色 -->

        <!-- 主内容区 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- 成果照片缩略图 -->
            <ImageView
                android:id="@+id/iv_photo_thumbnail"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@color/divider"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp" />

            <!-- 右侧任务详情 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/iv_photo_thumbnail"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <!-- 任务图标 + 任务标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <!-- 内置兴趣卡通图标本身，纯透明底，不带背景框 (大小 40dp x 40dp 占左侧两行) -->
                    <ImageView
                        android:id="@+id/iv_task_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tv_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="任务标题"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- 拍照记录的时间 -->
                <TextView
                    android:id="@+id/tv_photo_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="周一 10:15 AM"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <!-- 贡献的花瓣数提示 -->
                <TextView
                    android:id="@+id/tv_flower_reward_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸 3片花瓣"
                    android:textSize="11sp"
                    android:textColor="#E91E63"
                    android:textStyle="bold" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
