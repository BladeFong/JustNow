<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp">

    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/tv_tag_name"
        android:layout_width="@dimen/quadrant_col_tag_width"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.JustNow.Caption"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.JustNow.Body"
        android:textColor="@color/text_primary"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="@dimen/quadrant_col_duration_width"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.JustNow.Caption"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
