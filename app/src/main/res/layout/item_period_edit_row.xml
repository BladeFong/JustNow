<?xml version="1.0" encoding="utf-8"?>
<!-- 时段编辑行：[时段名] [spacer] [◀][HH:MM][▶]   [◀][HH:MM][▶] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingVertical="4dp">

    <!-- 时段名称 -->
    <TextView
        android:id="@+id/tv_period_edit_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.JustNow.Body" />

    <!-- spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 开始时间组：[◀][HH:MM][▶] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_start_dec"
            style="@style/Widget.JustNow.StepButton"
            android:src="@drawable/ic_step_left" />

        <TextView
            android:id="@+id/tv_period_edit_start"
            style="@style/Widget.JustNow.TimeEditText"
            android:text="09:00" />

        <ImageButton
            android:id="@+id/btn_start_inc"
            style="@style/Widget.JustNow.StepButton"
            android:src="@drawable/ic_step_right" />

    </LinearLayout>

    <!-- 结束时间组：[◀][HH:MM][▶] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp">

        <ImageButton
            android:id="@+id/btn_end_dec"
            style="@style/Widget.JustNow.StepButton"
            android:src="@drawable/ic_step_left" />

        <TextView
            android:id="@+id/tv_period_edit_end"
            style="@style/Widget.JustNow.TimeEditText"
            android:text="17:00" />

        <ImageButton
            android:id="@+id/btn_end_inc"
            style="@style/Widget.JustNow.StepButton"
            android:src="@drawable/ic_step_right" />

    </LinearLayout>

</LinearLayout>
